DATABASE_URL=postgresql+psycopg://agentguard:agentguard@localhost:5432/agentguard
REDIS_URL=redis://localhost:6379/0
ENVIRONMENT=development
APPROVAL_DEFAULT_EXPIRY_SECONDS=900

# Runtime controls
KILL_SWITCH=false
ALLOW_READS_WHEN_POLICY_UNAVAILABLE=false
BROKER_TIMEOUT_SECONDS=5
BREAKER_THRESHOLD=5
BREAKER_WINDOW_SECONDS=300

# Enables /v1/stats and signs a read-all "operator" principal into the console.
# Synthetic dev value — use a secrets manager outside local dev.
OPERATOR_TOKEN=dev-only-operator-token

# Console principals: only SHA-256 hashes of tokens live here. The synthetic dev tokens are
# dev-only-console-dana (support-lead, tenant-a) and dev-only-console-sam (viewer, all tenants).
# Hash a new one: python -c "from agentguard.console.auth import hash_token; print(hash_token('...'))"
CONSOLE_PRINCIPALS='[{"name":"dana","roles":["support-lead"],"tenants":["tenant-a"],"token_sha256":"f1d597e972dd03cca37f841890663b9f1d1008c3101e446902b7a4ddc8a7ec39"},{"name":"sam","roles":["viewer"],"tenants":["*"],"token_sha256":"47f7ef3bb04360981002cb122d067961c1b7c0d0a6da9fe5eef8a6bdbc1bf085"}]'

# Tracing: unset to disable. Points at Jaeger when using `--profile observability`.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Where tools run: "helpdesk" (the real service) or "inprocess" (test double).
TARGET_BACKEND=inprocess
HELPDESK_URL=http://127.0.0.1:8200
# Set BROKER_URL on the gateway to use the separate broker service; both sides share the token.
# BROKER_URL=http://127.0.0.1:8100
BROKER_SERVICE_TOKEN=dev-only-broker-service-token
# Target credentials (give these to the broker only). Synthetic dev values.
AGENTGUARD_CRED_TICKETS_READ=dev-only-tickets:read
AGENTGUARD_CRED_TICKETS_WRITE=dev-only-tickets:write
AGENTGUARD_CRED_BILLING_REFUND=dev-only-billing:refund

# Console SSO (Keycloak from docker-compose). Leave OIDC_ISSUER unset to use dev tokens only.
# OIDC_ISSUER=http://localhost:8081/realms/agentguard
# OIDC_JWKS_URL=http://localhost:8081/realms/agentguard/protocol/openid-connect/certs
CONSOLE_STATIC_TOKENS=true

# LLM support agent. Real keys come from your own secret store; never commit them.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# ANTHROPIC_API_KEY=
