DATABASE_URL=postgresql+psycopg://agentguard:agentguard@localhost:5432/agentguard
REDIS_URL=redis://localhost:6379/0
ENVIRONMENT=development
APPROVAL_DEFAULT_EXPIRY_SECONDS=900

# Runtime controls
KILL_SWITCH=false
ALLOW_READS_WHEN_POLICY_UNAVAILABLE=false
BROKER_TIMEOUT_SECONDS=5
BREAKER_THRESHOLD=5
BREAKER_WINDOW_SECONDS=300

# Enables /v1/stats. Synthetic dev value — use a secrets manager outside local dev.
OPERATOR_TOKEN=dev-only-operator-token

# Tracing: unset to disable. Points at Jaeger when using `--profile observability`.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
